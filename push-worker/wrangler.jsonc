{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "panka-pace-push",
	"main": "src/index.js",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"secrets": {
		"required": ["VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY"]
	},
	"kv_namespaces": [
		{
			"binding": "PUSH_SUBSCRIPTIONS",
			"id": "5062ce0869714579891be7c64482670c",
			"remote": true
		}
	],
	"vars": {
		"ALLOWED_ORIGIN": "https://lomixxx.github.io",
    "APP_URL": "https://lomixxx.github.io/panka-pdca/",
		"VAPID_SUBJECT": "mailto:purojekuto71@gmail.com"
	}
}
